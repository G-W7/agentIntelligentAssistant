# 复制为 .env 后填写真实密钥。.env 已被 .gitignore 忽略，不要提交。

# ---- 应用 ----
APP_NAME=Agent 智能助手
DEBUG=false

# ---- LLM（DeepSeek，OpenAI 兼容接口）----
DEEPSEEK_API_KEY=sk-xxxx
# 走代理或自建网关时填写，默认官方地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
TEMPERATURE=0.2

# ---- Embedding（千问 DashScope）----
DASHSCOPE_API_KEY=sk-xxxx
# 默认官方地址；如使用第三方网关（例如 https://cn-beijing.maas.qianwenaiapi.com/api/v1）按需替换，代码层已兼容返回结构差异
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 必须与 Milvus collection 维度一致，改动后需删除并重建 collection
EMBEDDING_DIMENSIONS=1024
# 同步接口单批上限 25，建议 10 以内
DASHSCOPE_BATCH_SIZE=10

# ---- 重排序（千问 DashScope Rerank）----
# 开启后：混合检索先粗召回 RERANK_RECALL 条，再由 rerank 模型精排取 MILVUS_TOP_K
RERANK_ENABLED=true
# gte-rerank 已于 2026-05 下线，改用 qwen3-rerank 系列
RERANK_MODEL=qwen3.7-text-rerank
RERANK_RECALL=20

# ---- 联网搜索（Tavily）----
TAVILY_API_KEY=tvly-xxxx
TAVILY_MAX_RESULTS=5

# ---- 文档解析（MinerU Open SDK）----
# 在 https://mineru.net 申请，用于 PDF/图片等复杂版式文档结构化解析
MINERU_TOKEN=sk-xxxx

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=postgres
POSTGRES_POOL_SIZE=8

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agent_knowledge_base
MILVUS_TOP_K=4

# ---- 文档切片 ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=240
MAX_UPLOAD_MB=20

# ---- 会话 ----
HISTORY_WINDOW=20

# ---- 前端 / 跨域 ----
BACKEND_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=*

# ---- Langfuse 可观测性（可选）----
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# Langfuse Cloud EU 用默认值；US 区改为 https://us.cloud.langfuse.com；自托管填自己的地址
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 采样率 0~1，生产高流量时可调低以控制上报量
LANGFUSE_SAMPLE_RATE=1.0