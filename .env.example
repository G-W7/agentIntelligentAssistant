# 复制为 .env 后填写真实密钥。.env 已被 .gitignore 忽略，不要提交。

# ---- LLM ----
OPENAI_API_KEY=sk-xxxx
# 走代理或自建网关时填写，例如 https://api.openai.com/v1
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini

# ---- Embedding ----
# openai: 使用 OpenAIEmbeddings；huggingface: 使用本地 BGE-M3（需装 langchain-huggingface）
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
# 必须与 Milvus collection 维度一致，改动后需删除并重建 collection
EMBEDDING_DIMENSIONS=1024
HF_EMBEDDING_MODEL=BAAI/bge-m3

# ---- 联网搜索 ----
TAVILY_API_KEY=tvly-xxxx

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_assistant

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agent_knowledge_base
MILVUS_TOP_K=4

# ---- 文档切片 ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=20

# ---- 会话 ----
HISTORY_WINDOW=20

# ---- 前端 / 跨域 ----
BACKEND_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=*
