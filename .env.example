# 复制为 .env 后填写真实密钥。.env 已被 .gitignore 忽略，不要提交。

# ---- 应用 ----
APP_NAME=Agent 智能助手
DEBUG=false

# ---- LLM（DeepSeek，OpenAI 兼容接口）----
DEEPSEEK_API_KEY=sk-xxxx
# 走代理或自建网关时填写，默认官方地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
TEMPERATURE=0.2

# ---- Embedding（千问 DashScope）----
DASHSCOPE_API_KEY=sk-xxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 必须与 Milvus collection 维度一致，改动后需删除并重建 collection
EMBEDDING_DIMENSIONS=1024
# 同步接口单批上限 25，建议 10 以内
DASHSCOPE_BATCH_SIZE=10

# ---- 联网搜索（Tavily）----
TAVILY_API_KEY=tvly-xxxx
TAVILY_MAX_RESULTS=5

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=postgres
POSTGRES_POOL_SIZE=8

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agent_knowledge_base
MILVUS_TOP_K=4

# ---- 文档切片 ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=240
MAX_UPLOAD_MB=20

# ---- 会话 ----
HISTORY_WINDOW=20

# ---- 前端 / 跨域 ----
BACKEND_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=*

# ---- Langfuse 可观测性（可选）----
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# Langfuse Cloud EU 用默认值；US 区改为 https://us.cloud.langfuse.com；自托管填自己的地址
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0